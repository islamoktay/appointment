# Copy this file to .env (never commit .env to Git)
# Generate a >= 256-bit JWT secret with: openssl rand -base64 32

# PostgreSQL (Local Docker Compose)
POSTGRES_DB=appointment_db
POSTGRES_USER=appointment_user
POSTGRES_PASSWORD=replace-with-local-dev-password

# Spring Boot Backend API
DB_URL=jdbc:postgresql://127.0.0.1:5432/appointment_db
DB_USERNAME=appointment_user
DB_PASSWORD=replace-with-local-dev-password
JWT_SECRET=replace-with-at-least-32-byte-random-secret-key
JWT_EXPIRATION_SECONDS=86400
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js Web Portal (Server-Side BFF -> Spring Boot API)
API_BASE_URL=http://localhost:8080
